---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonsCountdown from '../components/SeasonsCountdown.astro';
import MoonPhase from '../components/MoonPhase.astro';
---
<BaseLayout title="Calendario Astronómico - Omnitime">
  <h1 style="font-size: 2.5rem; font-weight: 700; color: var(--color-text); margin-bottom: 1rem;">
    Calendario Astronómico
  </h1>
  <p style="font-size: 1.125rem; color: var(--color-text-muted); max-width: 600px; margin-bottom: 2rem;">
    Medición del tiempo basada en ciclos celestes: años siderales, meses sinódicos,
    equinoccios, solsticios y fases lunares. Precisión astronómica para observadores.
  </p>

  <SeasonsCountdown client:visible />
  <MoonPhase client:visible />
</BaseLayout>