---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpochConverter from '../components/EpochConverter.astro';
---
<BaseLayout title="Calendario Científico - Omnitime">
  <h1 style="font-size: 2.5rem; font-weight: 700; color: var(--color-text); margin-bottom: 1rem;">
    Calendario Científico
  </h1>
  <p style="font-size: 1.125rem; color: var(--color-text-muted); max-width: 600px; margin-bottom: 2rem;">
    Sistema de medición temporal basado en constantes físicas universales.
    Incluye tiempo atómico, segundos SI, y referencias metrológicas internacionales.
  </p>

  <EpochConverter client:visible />
</BaseLayout>